# Copy to .env and edit. The app starts without this file using the defaults
# in app/core/config.py, which are the values in SPEC section 12.

# Secret for HMAC-SHA256 pass signing (SPEC section 9).
#
# REPLACE THE PLACEHOLDER. Anyone holding this value can forge a pass for any
# visit and walk through the gate. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET=change-me-before-any-real-use

# Timezone used for WORKING_HOURS and every "today" comparison (SPEC section 16.7).
LOCAL_TZ=Asia/Kolkata
